<?xml version="1.0" encoding="utf-8"?>
<!-- The PC-Mirror tab: where a cast starts, and the only place it can start.

     Two states, exactly one visible at a time:
       * a session running — a short card saying so, with the way back to its remote;
       * nothing running — the computers this phone is already paired with, one tap each, and
         "Find your PC" underneath for a new one.

     What a session *is* — frames, bitrate, sound, the debugging door — is not here. That belongs to
     the remote (PcLinkRemoteActivity), which is what the user is holding while it runs; keeping a
     second copy of it in the tab is how the two drifted apart the last time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ============================ a session is running ============================ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSession"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorControlHighlight">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvServerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvLinkState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:maxLines="1"
                android:ellipsize="end" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenRemote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/pclink_open_remote"
                android:textAllCaps="false"
                android:focusable="true"
                app:icon="@drawable/ic_remote_gen_24"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDisconnect"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/pclink_disconnect"
                android:textAllCaps="false"
                android:focusable="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============================ nothing running: the way in ============================ -->
    <LinearLayout
        android:id="@+id/boxIdle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Same construction as item_pc_server.xml (circle + two lines), so it must sit on the
             same column as the rows below it: 12dp here, inside the root's 12dp, puts its circle
             at 24dp — where an unpadded RecyclerView puts every row's own 12dp padding. -->
        <LinearLayout
            android:id="@+id/boxIdleHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:importantForAccessibility="no"
                    android:src="@drawable/bg_circle_pclink" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pclink_24" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pclink_title"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pclink_row_subtitle"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPairedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/pclink_paired_label"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPairedPcs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <!-- Not @string/pclink_empty: that one tells the user to start XPlayer Link on the PC
                 and wait, which is true on the connect screen (a discovery list) and impossible
                 here — this list is the pairing store, and only the ceremony writes to it.
                 Starts gone so it doesn't flash that line at everyone while loadPairings() reads
                 the store off the IO dispatcher; showPairings() turns it on when the store is
                 really empty. -->
            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone"
                android:text="@string/pclink_paired_empty"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFindPc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pclink_find_pc"
            android:textAllCaps="false"
            android:focusable="true"
            app:icon="@drawable/ic_pclink_24"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
