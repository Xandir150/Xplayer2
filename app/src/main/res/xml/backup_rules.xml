<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (and API 31+ when data_extraction_rules is absent). -->
<full-backup-content>
    <!-- Secrets: SMB passwords, and the PC Link identity and pairings, whose Keystore key does not
         travel with a backup (a restored copy would be unreadable and force a re-pair). -->
    <exclude domain="sharedpref" path="smb_credentials.xml" />
    <exclude domain="sharedpref" path="pc_link_identity.xml" />
    <exclude domain="sharedpref" path="pc_link_pairings.xml" />
</full-backup-content>
