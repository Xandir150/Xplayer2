<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (cloud backup and device-to-device transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="smb_credentials.xml" />
        <exclude domain="sharedpref" path="pc_link_identity.xml" />
        <exclude domain="sharedpref" path="pc_link_pairings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="smb_credentials.xml" />
        <exclude domain="sharedpref" path="pc_link_identity.xml" />
        <exclude domain="sharedpref" path="pc_link_pairings.xml" />
    </device-transfer>
</data-extraction-rules>
