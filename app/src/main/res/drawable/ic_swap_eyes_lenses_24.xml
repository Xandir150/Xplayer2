<?xml version="1.0" encoding="utf-8"?>
<!-- The lenses of the swap-eyes glyph, eyes in their places: left red, right blue. Two discs of
     radius 100 at the frame's ring centres (260,480) and (700,480) — exactly the inside of each
     ring of ic_swap_eyes_frame_24, which is drawn over them. Same 24dp / 960 geometry. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
  <path
      android:fillColor="@color/swap_eyes_red"
      android:pathData="M160,480a100,100 0 1,0 200,0a100,100 0 1,0 -200,0z"/>
  <path
      android:fillColor="@color/swap_eyes_blue"
      android:pathData="M600,480a100,100 0 1,0 200,0a100,100 0 1,0 -200,0z"/>
</vector>
