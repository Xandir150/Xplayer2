<?xml version="1.0" encoding="utf-8"?>
<!-- A pill outline on a toolbar action, so an icon (with or without a label) reads as a button.
     The ripple stays on the action's own, full-height background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="18dp" />
    <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
</shape>
