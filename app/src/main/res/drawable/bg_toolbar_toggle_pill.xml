<?xml version="1.0" encoding="utf-8"?>
<!-- A toolbar switch drawn as a pill, like the glasses-mode action beside it: outlined while off,
     the same outline with a soft white fill while on. Driven by View.isActivated. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#3DFFFFFF" />
            <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_toolbar_button_outline" />
</selector>
