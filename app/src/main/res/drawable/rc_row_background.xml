<!-- The remote's row shape, matching Widget.XPlayer.RemoteRow's tint and corner radius, for the
     rows that are a layout rather than a MaterialButton. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rc_row_pressed" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rc_row" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
