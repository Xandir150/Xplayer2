{
  "note": "XPL2 PC Link depth-control and stats test vectors (protocol.md sections 2.20 and 2.21), generated by docs/gen_depth_vectors.py. Depth quantities are integers in thousandths; limits are inclusive; a value outside them is clamped, a non-integer drops the whole message. `depth` is the only source of truth for a phone's sliders.",
  "defaults": {
    "divergence": 20,
    "convergence": 0
  },
  "limits": {
    "divergence": [
      0,
      50
    ],
    "convergence": [
      -500,
      500
    ]
  },
  "wire": [
    {
      "name": "set_depth: one slider, divergence",
      "direction": "client->server",
      "message": {
        "type": "set_depth",
        "divergence": 30
      },
      "line": "{\"type\":\"set_depth\",\"divergence\":30}\n"
    },
    {
      "name": "set_depth: one slider, convergence",
      "direction": "client->server",
      "message": {
        "type": "set_depth",
        "convergence": -100
      },
      "line": "{\"type\":\"set_depth\",\"convergence\":-100}\n"
    },
    {
      "name": "set_depth: both sliders",
      "direction": "client->server",
      "message": {
        "type": "set_depth",
        "divergence": 30,
        "convergence": -100
      },
      "line": "{\"type\":\"set_depth\",\"divergence\":30,\"convergence\":-100}\n"
    },
    {
      "name": "set_depth: reset",
      "direction": "client->server",
      "message": {
        "type": "set_depth",
        "reset": true
      },
      "line": "{\"type\":\"set_depth\",\"reset\":true}\n"
    },
    {
      "name": "set_depth: the limits themselves",
      "direction": "client->server",
      "message": {
        "type": "set_depth",
        "divergence": 50,
        "convergence": -500
      },
      "line": "{\"type\":\"set_depth\",\"divergence\":50,\"convergence\":-500}\n"
    },
    {
      "name": "depth: auto, converting, defaults",
      "direction": "server->client",
      "message": {
        "type": "depth",
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0,
        "defaults": {
          "divergence": 20,
          "convergence": 0
        },
        "limits": {
          "divergence": [
            0,
            50
          ],
          "convergence": [
            -500,
            500
          ]
        }
      },
      "line": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":20,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "depth: auto, not converting (glasses in 2D)",
      "direction": "server->client",
      "message": {
        "type": "depth",
        "setting": "auto",
        "active": false,
        "divergence": 20,
        "convergence": 0,
        "defaults": {
          "divergence": 20,
          "convergence": 0
        },
        "limits": {
          "divergence": [
            0,
            50
          ],
          "convergence": [
            -500,
            500
          ]
        }
      },
      "line": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":false,\"divergence\":20,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "depth: off in the window",
      "direction": "server->client",
      "message": {
        "type": "depth",
        "setting": "off",
        "active": false,
        "divergence": 20,
        "convergence": 0,
        "defaults": {
          "divergence": 20,
          "convergence": 0
        },
        "limits": {
          "divergence": [
            0,
            50
          ],
          "convergence": [
            -500,
            500
          ]
        }
      },
      "line": "{\"type\":\"depth\",\"setting\":\"off\",\"active\":false,\"divergence\":20,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "depth: on, after the phone moved both",
      "direction": "server->client",
      "message": {
        "type": "depth",
        "setting": "on",
        "active": true,
        "divergence": 35,
        "convergence": -120,
        "defaults": {
          "divergence": 20,
          "convergence": 0
        },
        "limits": {
          "divergence": [
            0,
            50
          ],
          "convergence": [
            -500,
            500
          ]
        }
      },
      "line": "{\"type\":\"depth\",\"setting\":\"on\",\"active\":true,\"divergence\":35,\"convergence\":-120,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "stats: a healthy 60 fps stream",
      "direction": "server->client",
      "message": {
        "type": "stats",
        "capture_fps": 59.8,
        "encode_fps": 59.8,
        "encode_ms": 3.1,
        "wire_mbps": 18.4
      },
      "line": "{\"type\":\"stats\",\"capture_fps\":59.8,\"encode_fps\":59.8,\"encode_ms\":3.1,\"wire_mbps\":18.4}\n"
    },
    {
      "name": "stats: a desktop nobody is touching",
      "direction": "server->client",
      "message": {
        "type": "stats",
        "capture_fps": 2.0,
        "encode_fps": 2.0,
        "encode_ms": 4.7,
        "wire_mbps": 0.6
      },
      "line": "{\"type\":\"stats\",\"capture_fps\":2.0,\"encode_fps\":2.0,\"encode_ms\":4.7,\"wire_mbps\":0.6}\n"
    }
  ],
  "decode": [
    {
      "name": "depth: the reference line",
      "line": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":20,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n",
      "message": {
        "type": "depth",
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0,
        "defaults": {
          "divergence": 20,
          "convergence": 0
        },
        "limits": {
          "divergence": [
            0,
            50
          ],
          "convergence": [
            -500,
            500
          ]
        }
      }
    },
    {
      "name": "depth: an unknown field is ignored",
      "line": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":20,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]},\"model\":\"v-model-2\"}\n",
      "message": {
        "type": "depth",
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0,
        "defaults": {
          "divergence": 20,
          "convergence": 0
        },
        "limits": {
          "divergence": [
            0,
            50
          ],
          "convergence": [
            -500,
            500
          ]
        }
      }
    },
    {
      "name": "depth: an unrecognized setting is accepted",
      "line": "{\"type\":\"depth\",\"setting\":\"hdr\",\"active\":true,\"divergence\":20,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n",
      "message": {
        "type": "depth",
        "setting": "hdr",
        "active": true,
        "divergence": 20,
        "convergence": 0,
        "defaults": {
          "divergence": 20,
          "convergence": 0
        },
        "limits": {
          "divergence": [
            0,
            50
          ],
          "convergence": [
            -500,
            500
          ]
        }
      }
    },
    {
      "name": "depth: a string where an integer belongs is ignored whole",
      "line": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":\"20\",\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n",
      "message": null
    },
    {
      "name": "depth: a non-boolean active is ignored whole",
      "line": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":\"yes\",\"divergence\":20,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n",
      "message": null
    },
    {
      "name": "depth: missing limits is ignored whole",
      "line": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":20,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0}}\n",
      "message": null
    },
    {
      "name": "stats: the reference line",
      "line": "{\"type\":\"stats\",\"capture_fps\":59.8,\"encode_fps\":59.8,\"encode_ms\":3.1,\"wire_mbps\":18.4}\n",
      "message": {
        "type": "stats",
        "capture_fps": 59.8,
        "encode_fps": 59.8,
        "encode_ms": 3.1,
        "wire_mbps": 18.4
      }
    },
    {
      "name": "stats: integers are numbers too",
      "line": "{\"type\":\"stats\",\"capture_fps\":60,\"encode_fps\":60,\"encode_ms\":3,\"wire_mbps\":18}\n",
      "message": {
        "type": "stats",
        "capture_fps": 60,
        "encode_fps": 60,
        "encode_ms": 3,
        "wire_mbps": 18
      }
    },
    {
      "name": "stats: an unknown field is ignored",
      "line": "{\"type\":\"stats\",\"capture_fps\":59.8,\"encode_fps\":59.8,\"encode_ms\":3.1,\"wire_mbps\":18.4,\"dropped\":0}\n",
      "message": {
        "type": "stats",
        "capture_fps": 59.8,
        "encode_fps": 59.8,
        "encode_ms": 3.1,
        "wire_mbps": 18.4
      }
    },
    {
      "name": "stats: a string where a number belongs is ignored whole",
      "line": "{\"type\":\"stats\",\"capture_fps\":\"59.8\",\"encode_fps\":59.8,\"encode_ms\":3.1,\"wire_mbps\":18.4}\n",
      "message": null
    },
    {
      "name": "stats: a missing figure is ignored whole",
      "line": "{\"type\":\"stats\",\"capture_fps\":59.8,\"encode_fps\":59.8,\"encode_ms\":3.1}\n",
      "message": null
    }
  ],
  "apply": [
    {
      "name": "one slider moves, the other is left alone",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "divergence": 30
      },
      "after": {
        "divergence": 30,
        "convergence": 0
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":30,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "the other slider, alone",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "convergence": -100
      },
      "after": {
        "divergence": 20,
        "convergence": -100
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":20,\"convergence\":-100,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "both at once",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "divergence": 30,
        "convergence": -100
      },
      "after": {
        "divergence": 30,
        "convergence": -100
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":30,\"convergence\":-100,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "overshoot is clamped to the top",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "divergence": 80
      },
      "after": {
        "divergence": 50,
        "convergence": 0
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":50,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "undershoot is clamped to the bottom",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "divergence": -1
      },
      "after": {
        "divergence": 0,
        "convergence": 0
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":0,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "convergence clamps both ways",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "convergence": 900
      },
      "after": {
        "divergence": 20,
        "convergence": 500
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":20,\"convergence\":500,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "convergence clamps both ways, the other way",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "convergence": -900
      },
      "after": {
        "divergence": 20,
        "convergence": -500
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":20,\"convergence\":-500,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "reset restores the defaults",
      "before": {
        "setting": "on",
        "active": true,
        "divergence": 35,
        "convergence": -120
      },
      "message": {
        "type": "set_depth",
        "reset": true
      },
      "after": {
        "divergence": 20,
        "convergence": 0
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"on\",\"active\":true,\"divergence\":20,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "reset wins over values in the same message",
      "before": {
        "setting": "on",
        "active": true,
        "divergence": 35,
        "convergence": -120
      },
      "message": {
        "type": "set_depth",
        "divergence": 40,
        "convergence": 200,
        "reset": true
      },
      "after": {
        "divergence": 20,
        "convergence": 0
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"on\",\"active\":true,\"divergence\":20,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "reset false is the same as absent",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "divergence": 40,
        "reset": false
      },
      "after": {
        "divergence": 40,
        "convergence": 0
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":40,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "an unknown field is ignored, the rest applies",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "divergence": 30,
        "model": "v-model-2"
      },
      "after": {
        "divergence": 30,
        "convergence": 0
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":30,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "an empty message changes nothing and is still acknowledged",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth"
      },
      "after": {
        "divergence": 20,
        "convergence": 0
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":true,\"divergence\":20,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    },
    {
      "name": "a fraction is a content error: the whole message is dropped",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "divergence": 2.5,
        "convergence": -100
      },
      "after": null,
      "ack": null
    },
    {
      "name": "a boolean where an integer belongs is a content error",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "divergence": true
      },
      "after": null,
      "ack": null
    },
    {
      "name": "a non-boolean reset is a content error",
      "before": {
        "setting": "auto",
        "active": true,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "reset": "yes"
      },
      "after": null,
      "ack": null
    },
    {
      "name": "applies while not converting too: the saved slider still moves",
      "before": {
        "setting": "auto",
        "active": false,
        "divergence": 20,
        "convergence": 0
      },
      "message": {
        "type": "set_depth",
        "divergence": 25
      },
      "after": {
        "divergence": 25,
        "convergence": 0
      },
      "ack": "{\"type\":\"depth\",\"setting\":\"auto\",\"active\":false,\"divergence\":25,\"convergence\":0,\"defaults\":{\"divergence\":20,\"convergence\":0},\"limits\":{\"divergence\":[0,50],\"convergence\":[-500,500]}}\n"
    }
  ],
  "gate": [
    {
      "name": "a client from before this section",
      "hello": {},
      "sends_set_depth": false,
      "depth_offered": false,
      "stats_sent": false
    },
    {
      "name": "asks for depth only",
      "hello": {
        "depth": true
      },
      "sends_set_depth": false,
      "depth_offered": true,
      "stats_sent": false
    },
    {
      "name": "asks for stats only",
      "hello": {
        "stats": true
      },
      "sends_set_depth": false,
      "depth_offered": false,
      "stats_sent": true
    },
    {
      "name": "asks for both",
      "hello": {
        "depth": true,
        "stats": true
      },
      "sends_set_depth": false,
      "depth_offered": true,
      "stats_sent": true
    },
    {
      "name": "never asked, then sends set_depth: a late hint",
      "hello": {},
      "sends_set_depth": true,
      "depth_offered": true,
      "stats_sent": false
    },
    {
      "name": "says false, which is the same as absent",
      "hello": {
        "depth": false,
        "stats": false
      },
      "sends_set_depth": false,
      "depth_offered": false,
      "stats_sent": false
    }
  ]
}
